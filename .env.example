# Copy to ".env" and fill in secrets. Never commit ".env".

# --- Required for local runs (create_app validates unless TESTING mode) ---
# Whisper / audio transcription (direct api.openai.com).
OPENAI_API_KEY=
# Chat completions: grading, feedback, validation (OpenRouter base URL).
OPENROUTER_API_KEY=

# --- Data layout ---
# Writable root: rubrics go to GRADER_DATA_DIR/rubrics/rubrica_activa.md
# Results append to GRADER_DATA_DIR/resultados.json
GRADER_DATA_DIR=./data

# --- Models (avoid hardcoding in code; change per environment) ---
# Primary chat model for grading (canonical name per project brief).
LLM_MODEL=gpt-4o
# Deprecated: use LLM_MODEL. Still read for backward compatibility if LLM_MODEL is unset.
# GRADER_CHAT_MODEL=gpt-4o

GRADER_TRANSCRIPTION_MODEL=whisper-1
# Hint passed to the transcription API (e.g. es, en)
GRADER_TRANSCRIPTION_LANGUAGE=es

# Max pages per student PDF for text extraction (non-numeric or empty → default 4; minimum 1)
# GRADER_PDF_MAX_PAGES=4

# --- LLM validation (optional second pass; wired in later phases) ---
VALIDATION_LLM_MODEL=gpt-4o-mini
SKIP_LLM_VALIDATION=false

# --- Max output tokens by call type (central settings; pipeline wiring in later phases) ---
# Defaults mirror former GRADER_MAX_COMPLETION_LISTAR / RETRO / a sensible validation cap.
GRADING_MAX_TOKENS=8192
FEEDBACK_MAX_TOKENS=4096
VALIDATION_MAX_TOKENS=2048

# --- Prompt overrides ---
# Optional: folder with .md prompts (defaults to packaged prompts under src/grader_agent/prompts)
GRADER_AGENT_PROMPTS_DIR=

# --- Sampling / output size (per-completion kinds; still used by grading_config) ---
GRADER_SCORE_TEMPERATURE=0
GRADER_RETRO_TEMPERATURE=0.8
GRADER_MAX_COMPLETION_ESCALA=256
GRADER_MAX_COMPLETION_PUNTAJE=256
GRADER_MAX_COMPLETION_LISTAR=8192
GRADER_MAX_COMPLETION_RETRO=4096

# --- OpenAI resilience ---
# Retries on 429 TPM/RPM (default 8, max 30; non-numeric falls back to default; does not apply to insufficient_quota)
OPENAI_RATE_LIMIT_MAX_RETRIES=

# --- Logging ---
LOG_LEVEL=INFO
# Optional: append logs to this file (absolute or relative to process cwd). Empty = console only.
LOG_FILE_PATH=
# Optional: 1 to hide duplicate Werkzeug access lines
WERKZEUG_LOG_QUIET=

# --- Flask ---
FLASK_DEBUG=0
# pytest / tests: not usually needed; conftest uses create_app(testing=True)
FLASK_TESTING=
