# Copia este archivo a .env y rellena tu clave (nunca subas .env al repositorio).
OPENAI_API_KEY=
# Opcional: DEBUG, INFO, WARNING… (default INFO)
LOG_LEVEL=
# Opcional: 1 para ocultar líneas de acceso duplicadas de Werkzeug
WERKZEUG_LOG_QUIET=
# Opcional: carpeta con .md de prompts (_base_evaluador.md, _base_evaluador_puntaje.md, _retro_alumno.md, pdf_*.md, texto_*.md, …)
GRADER_AGENT_PROMPTS_DIR=
# Opcional: temperatura OpenAI para la decisión de puntaje (default 0)
GRADER_SCORE_TEMPERATURE=
# Opcional: temperatura para retroalimentación al alumno (default 0.8)
GRADER_RETRO_TEMPERATURE=
# Opcional: tope max_completion_tokens por tipo (defaults: escala/puntaje 256, listar 8192, retro 4096). Valores muy bajos pueden truncar el JSON.
GRADER_MAX_COMPLETION_ESCALA=
GRADER_MAX_COMPLETION_PUNTAJE=
GRADER_MAX_COMPLETION_LISTAR=
GRADER_MAX_COMPLETION_RETRO=
