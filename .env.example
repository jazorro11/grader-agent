# Copy to ".env" and fill in secrets. Never commit ".env".

# --- Required for local runs (create_app validates unless TESTING mode) ---
OPENAI_API_KEY=

# --- Data layout ---
# Writable root: rubrics go to GRADER_DATA_DIR/rubrics/rubrica_activa.md
# Results append to GRADER_DATA_DIR/resultados.json
GRADER_DATA_DIR=./data

# --- Models (avoid hardcoding in code; change per environment) ---
GRADER_CHAT_MODEL=gpt-4o
GRADER_TRANSCRIPTION_MODEL=whisper-1
# Hint passed to the transcription API (e.g. es, en)
GRADER_TRANSCRIPTION_LANGUAGE=es

# --- Prompt overrides ---
# Optional: folder with .md prompts (defaults to packaged prompts under src/grader_agent/prompts)
GRADER_AGENT_PROMPTS_DIR=

# --- Sampling / output size ---
GRADER_SCORE_TEMPERATURE=0
GRADER_RETRO_TEMPERATURE=0.8
GRADER_MAX_COMPLETION_ESCALA=256
GRADER_MAX_COMPLETION_PUNTAJE=256
GRADER_MAX_COMPLETION_LISTAR=8192
GRADER_MAX_COMPLETION_RETRO=4096

# --- OpenAI resilience ---
# Retries on 429 TPM/RPM (default 8, max 30; non-numeric falls back to default; does not apply to insufficient_quota)
OPENAI_RATE_LIMIT_MAX_RETRIES=

# --- Logging ---
LOG_LEVEL=INFO
# Optional: 1 to hide duplicate Werkzeug access lines
WERKZEUG_LOG_QUIET=

# --- Flask ---
FLASK_DEBUG=0
# pytest / tests: not usually needed; conftest uses create_app(testing=True)
FLASK_TESTING=
